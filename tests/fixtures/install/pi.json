{
  "mcpServers": {
    "jev": {
      "command": "/opt/uv/uvx",
      "args": [
        "--from",
        "/work/jev-mcp[typesafe]",
        "jev-judge-mcp"
      ],
      "env": {
        "TYPESAFE_API_KEY": "${TYPESAFE_API_KEY}"
      },
      "lifecycle": "eager",
      "directTools": [
        "jev_verify",
        "jev_screen",
        "jev_find",
        "jev_classify",
        "jev_decide",
        "jev_rerank",
        "jev_compare",
        "jev_extract",
        "jev_review",
        "jev_gate",
        "jev_score",
        "jev_file_judge",
        "jev_ask",
        "jev_files_judge",
        "get_jev_mcp_skill_md"
      ],
      "toolPrefix": "none"
    }
  }
}
