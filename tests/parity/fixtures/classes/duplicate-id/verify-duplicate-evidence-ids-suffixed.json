{
  "id": "duplicate-id/verify-duplicate-evidence-ids-suffixed",
  "source": {
    "case": "duplicate-id/verify-duplicate-evidence-ids-suffixed"
  },
  "classes": [
    "duplicate-id"
  ],
  "divergences": ["ADR-0062"],
  "calls": [
    {
      "env": {
        "JEV_API_BASE_URL": "{{FAKE_URL}}/v1/systemone",
        "JEV_API_KEY": "parity-test-key",
        "JEV_PROVIDER": "compatible"
      },
      "tool": "jev_verify",
      "arguments": {
        "claims": [
          "x"
        ],
        "evidence": [
          {
            "id": "doc",
            "text": "one"
          },
          {
            "id": "doc",
            "text": "two"
          },
          {
            "text": "three"
          }
        ]
      },
      "exchanges": [
        {
          "request": {
            "method": "POST",
            "path": "/v1/systemone",
            "authorization": "Bearer parity-test-key",
            "content_type": "application/json",
            "body": {
              "model": "jev-latest",
              "state": {
                "purpose": "Verify each claim in claims against the evidence in evidence.",
                "claims": [
                  {
                    "text": "x",
                    "id": "claim0"
                  }
                ],
                "evidence": [
                  {
                    "id": "doc",
                    "text": "one"
                  },
                  {
                    "id": "doc_1",
                    "text": "two"
                  },
                  {
                    "text": "three",
                    "id": "evidence2"
                  }
                ]
              },
              "questions": {
                "relation_claim0": {
                  "type": "choice",
                  "instructions": "How does the evidence relate to claim `claim0` (x)?",
                  "criteria": {
                    "supports": "The evidence states the claim or directly implies that it is true",
                    "contradicts": "The evidence states the opposite of the claim or implies that it is false",
                    "says_nothing": "The evidence does not address what the claim asserts, either way"
                  }
                },
                "source_claim0": {
                  "type": "choice",
                  "instructions": "Which evidence item does claim `claim0` (x) rest on?",
                  "criteria": {
                    "doc": null,
                    "doc_1": null,
                    "evidence2": null,
                    "none": "No single evidence item contains the content the claim depends on"
                  }
                }
              }
            }
          },
          "response": {
            "status": 200,
            "body": "{\"answers\":{\"relation_claim0\":{\"choice\":\"supports\",\"confidence\":0.9,\"probabilities\":{\"supports\":0.9,\"contradicts\":0.05,\"says_nothing\":0.05}},\"source_claim0\":{\"choice\":\"doc_1\",\"confidence\":0.8,\"probabilities\":{\"doc\":0.05,\"doc_1\":0.85,\"evidence2\":0.05,\"none\":0.05}}},\"usage\":{\"input_tokens\":321,\"output_tokens\":17}}"
          }
        }
      ],
      "result": {
        "content": [
          {
            "type": "text",
            "text": "{\n  \"tool\": \"jev_verify\",\n  \"model\": \"jev-latest\",\n  \"provider\": \"compatible\",\n  \"auto_accept\": 0.8,\n  \"summary\": {\n    \"verified\": 1,\n    \"contradicted\": 0,\n    \"unsupported\": 0,\n    \"needs_review\": 0\n  },\n  \"results\": [\n    {\n      \"id\": \"claim0\",\n      \"claim\": \"x\",\n      \"verdict\": \"verified\",\n      \"probabilities\": {\n        \"supports\": 0.9,\n        \"contradicts\": 0.05,\n        \"says_nothing\": 0.05\n      },\n      \"confidence\": 0.9,\n      \"action\": \"auto\",\n      \"supporting_evidence\": \"doc_1\"\n    }\n  ],\n  \"usage\": {\n    \"input_tokens\": 321,\n    \"output_tokens\": 17\n  }\n}"
          }
        ]
      }
    }
  ]
}
