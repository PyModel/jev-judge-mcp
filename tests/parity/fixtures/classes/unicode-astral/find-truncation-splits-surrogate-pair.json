{
  "id": "unicode-astral/find-truncation-splits-surrogate-pair",
  "source": {
    "case": "unicode-astral/find-truncation-splits-surrogate-pair"
  },
  "classes": [
    "unicode-astral"
  ],
  "divergences": [
    "ADR-0005"
  ],
  "note": "Quirk Q8: slice(0, 2000) keeps the high surrogate of U+1F600, which JSON.stringify escapes as \\ud83d. Python drops the dangling unit (ADR-0005).",
  "calls": [
    {
      "env": {
        "JEV_API_BASE_URL": "{{FAKE_URL}}/v1/systemone",
        "JEV_API_KEY": "parity-test-key",
        "JEV_PROVIDER": "compatible"
      },
      "tool": "jev_find",
      "arguments": {
        "query": "which note ends in an emoji",
        "candidates": [
          {
            "id": "split",
            "text": "😀 tail"
          },
          {
            "id": "plain",
            "text": "short"
          }
        ]
      },
      "exchanges": [
        {
          "request": {
            "method": "POST",
            "path": "/v1/systemone",
            "authorization": "Bearer parity-test-key",
            "content_type": "application/json",
            "body": {
              "model": "jev-latest",
              "state": {
                "query": "which note ends in an emoji",
                "candidates": [
                  {
                    "id": "split",
                    "text": "\ud83d […truncated]"
                  },
                  {
                    "id": "plain",
                    "text": "short"
                  }
                ]
              },
              "questions": {
                "best": {
                  "type": "choice",
                  "instructions": "Which candidate contains the best answer to: \"which note ends in an emoji\"?",
                  "criteria": {
                    "split": null,
                    "plain": null
                  }
                },
                "exists": {
                  "type": "noul",
                  "instructions": "Does any candidate address or answer: \"which note ends in an emoji\"?",
                  "criteria": {
                    "true": "At least one candidate states or directly implies the answer",
                    "false": "No candidate addresses this"
                  }
                }
              }
            }
          },
          "response": {
            "status": 200,
            "body": "{\"answers\":{\"best\":{\"choice\":\"split\",\"confidence\":0.7,\"probabilities\":{\"split\":0.8,\"plain\":0.2}},\"exists\":{\"noul\":0.9}},\"usage\":{\"input_tokens\":321,\"output_tokens\":17}}"
          }
        }
      ],
      "result": {
        "content": [
          {
            "type": "text",
            "text": "{\n  \"tool\": \"jev_find\",\n  \"model\": \"jev-latest\",\n  \"provider\": \"compatible\",\n  \"query\": \"which note ends in an emoji\",\n  \"exists\": 0.9,\n  \"exists_verdict\": \"answered\",\n  \"top\": [\n    {\n      \"id\": \"split\",\n      \"probability\": 0.8,\n      \"text\": \"\\ud83d […truncated]\"\n    },\n    {\n      \"id\": \"plain\",\n      \"probability\": 0.2,\n      \"text\": \"short\"\n    }\n  ],\n  \"usage\": {\n    \"input_tokens\": 321,\n    \"output_tokens\": 17\n  }\n}"
          }
        ]
      }
    }
  ]
}
