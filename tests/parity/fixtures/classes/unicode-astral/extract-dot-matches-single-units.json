{
  "id": "unicode-astral/extract-dot-matches-single-units",
  "source": {
    "case": "unicode-astral/extract-dot-matches-single-units"
  },
  "classes": [
    "unicode-astral"
  ],
  "divergences": [],
  "note": "Without u, '.' matches one UTF-16 unit, so U+1F600 yields two lone-surrogate candidates; the pick is kept and escaped (ADR-0004, ADR-0006).",
  "calls": [
    {
      "env": {
        "JEV_API_BASE_URL": "{{FAKE_URL}}/v1/systemone",
        "JEV_API_KEY": "parity-test-key",
        "JEV_PROVIDER": "compatible"
      },
      "tool": "jev_extract",
      "arguments": {
        "document": "x😀y",
        "fields": [
          {
            "id": "unit",
            "pattern": ".",
            "description": "The second code unit."
          }
        ]
      },
      "exchanges": [
        {
          "request": {
            "method": "POST",
            "path": "/v1/systemone",
            "authorization": "Bearer parity-test-key",
            "content_type": "application/json",
            "body": {
              "model": "jev-latest",
              "state": {
                "purpose": null,
                "document": "x😀y",
                "fields": [
                  {
                    "id": "f0",
                    "description": "The second code unit.",
                    "pattern": "."
                  }
                ]
              },
              "questions": {
                "f0": {
                  "type": "choice",
                  "instructions": "Which candidate is the correct value of the field \"unit\" (The second code unit.) in the document in the state? Pick the exact substring the document presents as this field's value.",
                  "criteria": {
                    "c0": "Candidate value: \"x\"",
                    "c1": "Candidate value: \"\\ud83d\"",
                    "c2": "Candidate value: \"\\ude00\"",
                    "c3": "Candidate value: \"y\"",
                    "none_of_them": "None of the candidates is the value this field asks for"
                  }
                }
              }
            }
          },
          "response": {
            "status": 200,
            "body": "{\"answers\":{\"f0\":{\"choice\":\"c1\",\"confidence\":0.85,\"probabilities\":{\"c0\":0.05,\"c1\":0.85,\"c2\":0.04,\"c3\":0.04,\"none_of_them\":0.02}}},\"usage\":{\"input_tokens\":321,\"output_tokens\":17}}"
          }
        }
      ],
      "result": {
        "content": [
          {
            "type": "text",
            "text": "{\n  \"tool\": \"jev_extract\",\n  \"model\": \"jev-latest\",\n  \"provider\": \"compatible\",\n  \"summary\": {\n    \"fields\": 1,\n    \"extracted\": 1,\n    \"auto\": 1,\n    \"review\": 0,\n    \"not_found\": 0,\n    \"invalid\": 0\n  },\n  \"thresholds\": {\n    \"auto_accept\": 0.85,\n    \"minimum_margin\": 0.5\n  },\n  \"results\": [\n    {\n      \"id\": \"unit\",\n      \"value\": \"\\ud83d\",\n      \"status\": \"auto\",\n      \"reason\": null,\n      \"confidence\": 0.85,\n      \"top_probability\": 0.85,\n      \"margin\": 0.7999999999999999,\n      \"candidates_considered\": 4,\n      \"candidates_truncated\": false,\n      \"matches_skipped_too_long\": 0\n    }\n  ],\n  \"usage\": {\n    \"input_tokens\": 321,\n    \"output_tokens\": 17\n  }\n}"
          }
        ]
      }
    }
  ]
}
