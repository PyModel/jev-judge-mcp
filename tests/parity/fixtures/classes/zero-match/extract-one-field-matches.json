{
  "id": "zero-match/extract-one-field-matches",
  "source": {
    "case": "zero-match/extract-one-field-matches"
  },
  "classes": [
    "zero-match"
  ],
  "divergences": [],
  "note": "Only f1 reaches the wire; the zero-match field is not_found/no_regex_matches.",
  "calls": [
    {
      "env": {
        "JEV_API_BASE_URL": "{{FAKE_URL}}/v1/systemone",
        "JEV_API_KEY": "parity-test-key",
        "JEV_PROVIDER": "compatible"
      },
      "tool": "jev_extract",
      "arguments": {
        "document": "Build ABC-123 passed. Build ABC-124 failed. Contact: ops@example.test",
        "fields": [
          {
            "id": "phone",
            "pattern": "\\+\\d{11}",
            "description": "A phone number."
          },
          {
            "id": "build",
            "pattern": "[A-Z]{3}-\\d+",
            "description": "The build id that failed."
          }
        ]
      },
      "exchanges": [
        {
          "request": {
            "method": "POST",
            "path": "/v1/systemone",
            "authorization": "Bearer parity-test-key",
            "content_type": "application/json",
            "body": {
              "model": "jev-latest",
              "state": {
                "purpose": null,
                "document": "Build ABC-123 passed. Build ABC-124 failed. Contact: ops@example.test",
                "fields": [
                  {
                    "id": "f1",
                    "description": "The build id that failed.",
                    "pattern": "[A-Z]{3}-\\d+"
                  }
                ]
              },
              "questions": {
                "f1": {
                  "type": "choice",
                  "instructions": "Which candidate is the correct value of the field \"build\" (The build id that failed.) in the document in the state? Pick the exact substring the document presents as this field's value.",
                  "criteria": {
                    "c0": "Candidate value: \"ABC-123\"",
                    "c1": "Candidate value: \"ABC-124\"",
                    "none_of_them": "None of the candidates is the value this field asks for"
                  }
                }
              }
            }
          },
          "response": {
            "status": 200,
            "body": "{\"answers\":{\"f1\":{\"choice\":\"c1\",\"confidence\":0.94,\"probabilities\":{\"c0\":0.03,\"c1\":0.95,\"none_of_them\":0.02}}},\"usage\":{\"input_tokens\":321,\"output_tokens\":17}}"
          }
        }
      ],
      "result": {
        "content": [
          {
            "type": "text",
            "text": "{\n  \"tool\": \"jev_extract\",\n  \"model\": \"jev-latest\",\n  \"provider\": \"compatible\",\n  \"summary\": {\n    \"fields\": 2,\n    \"extracted\": 1,\n    \"auto\": 1,\n    \"review\": 0,\n    \"not_found\": 1,\n    \"invalid\": 0\n  },\n  \"thresholds\": {\n    \"auto_accept\": 0.85,\n    \"minimum_margin\": 0.5\n  },\n  \"results\": [\n    {\n      \"id\": \"phone\",\n      \"value\": null,\n      \"status\": \"not_found\",\n      \"reason\": \"no_regex_matches\",\n      \"candidates_considered\": 0,\n      \"candidates_truncated\": false,\n      \"matches_skipped_too_long\": 0\n    },\n    {\n      \"id\": \"build\",\n      \"value\": \"ABC-124\",\n      \"status\": \"auto\",\n      \"reason\": null,\n      \"confidence\": 0.94,\n      \"top_probability\": 0.95,\n      \"margin\": 0.9199999999999999,\n      \"candidates_considered\": 2,\n      \"candidates_truncated\": false,\n      \"matches_skipped_too_long\": 0\n    }\n  ],\n  \"usage\": {\n    \"input_tokens\": 321,\n    \"output_tokens\": 17\n  }\n}"
          }
        ]
      }
    }
  ]
