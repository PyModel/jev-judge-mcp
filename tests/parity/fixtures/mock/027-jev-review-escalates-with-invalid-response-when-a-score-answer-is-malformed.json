      "result": {
        "content": [
          {
            "type": "text",
            "text": "{\n  \"tool\": \"jev_review\",\n  \"model\": \"jev-latest\",\n  \"provider\": \"compatible\",\n  \"truncated\": false,\n  \"safe_to_apply\": 0.95,\n  \"scores\": {\n    \"correctness\": {\n      \"score\": null,\n      \"confidence\": null,\n      \"status\": \"invalid_response\"\n    },\n    \"spec_match\": {\n      \"score\": 2,\n      \"confidence\": 0.93\n    },\n    \"test_gap\": {\n      \"score\": 0,\n      \"confidence\": 0.93\n    },\n    \"blast_radius\": {\n      \"score\": 0,\n      \"confidence\": 0.93\n    }\n  },\n  \"weights\": {\n    \"correctness\": 0.4,\n    \"spec_match\": 0.3,\n    \"test_gap\": 0.15,\n    \"blast_radius\": 0.15\n  },\n  \"thresholds\": {\n    \"auto_accept\": 0.8,\n    \"review_at\": 0.5,\n    \"composite_floor\": 0.7\n  },\n  \"action\": \"escalate\",\n  \"status\": \"invalid_response\",\n  \"composite\": null,\n  \"usage\": {\n    \"input_tokens\": 10,\n    \"output_tokens\": 10\n  }\n}"
