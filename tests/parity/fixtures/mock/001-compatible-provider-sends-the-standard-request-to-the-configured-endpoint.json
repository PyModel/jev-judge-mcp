{
  "id": "mock-001",
  "source": {
    "file": "test/mock.test.mjs",
    "test": "compatible provider sends the standard request to the configured endpoint"
  },
  "classes": [
    "mock"
  ],
  "divergences": [],
  "reference_assertions_failed_under_compatible": [],
  "calls": [
    {
      "env": {
        "JEV_API_BASE_URL": "{{FAKE_URL}}/v1/systemone",
        "JEV_API_KEY": "compatible-test-key",
        "JEV_MCP_MODEL": "compatible-model",
        "JEV_PROVIDER": "compatible"
      },
      "tool": "jev_verify",
      "arguments": {
        "claims": [
          "The patch is ready"
        ],
        "evidence": "The tests pass"
      },
      "exchanges": [
        {
          "request": {
            "method": "POST",
            "path": "/v1/systemone",
            "authorization": "Bearer compatible-test-key",
            "content_type": "application/json",
            "body": {
              "model": "compatible-model",
              "state": {
                "purpose": "Verify each claim in claims against the evidence in evidence.",
                "claims": [
                  {
                    "text": "The patch is ready",
                    "id": "claim0"
                  }
                ],
                "evidence": [
                  {
                    "id": "evidence",
                    "text": "The tests pass"
                  }
                ]
              },
              "questions": {
                "relation_claim0": {
                  "type": "choice",
                  "instructions": "How does the evidence relate to claim `claim0` (The patch is ready)?",
                  "criteria": {
                    "supports": "The evidence states the claim or directly implies that it is true",
                    "contradicts": "The evidence states the opposite of the claim or implies that it is false",
                    "says_nothing": "The evidence does not address what the claim asserts, either way"
                  }
                }
              }
            }
          },
          "response": {
            "status": 200,
            "body": "{\"answers\":{\"relation_claim0\":{\"choice\":\"supports\",\"confidence\":0.99,\"probabilities\":{\"supports\":0.95,\"contradicts\":0.025,\"says_nothing\":0.025}}},\"usage\":{\"input_tokens\":10,\"output_tokens\":10},\"model\":\"compatible-model\"}"
          }
        }
      ],
      "result": {
        "content": [
          {
            "type": "text",
            "text": "{\n  \"tool\": \"jev_verify\",\n  \"model\": \"compatible-model\",\n  \"provider\": \"compatible\",\n  \"auto_accept\": 0.8,\n  \"summary\": {\n    \"verified\": 1,\n    \"contradicted\": 0,\n    \"unsupported\": 0,\n    \"needs_review\": 0\n  },\n  \"results\": [\n    {\n      \"id\": \"claim0\",\n      \"claim\": \"The patch is ready\",\n      \"verdict\": \"verified\",\n      \"probabilities\": {\n        \"supports\": 0.95,\n        \"contradicts\": 0.025,\n        \"says_nothing\": 0.025\n      },\n      \"confidence\": 0.99,\n      \"action\": \"auto\",\n      \"supporting_evidence\": null\n    }\n  ],\n  \"usage\": {\n    \"input_tokens\": 10,\n    \"output_tokens\": 10\n  }\n}"
          }
        ]
      }
    }
  ]
}
